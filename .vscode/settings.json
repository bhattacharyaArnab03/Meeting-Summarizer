{
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.profiles.windows": {
        "Meeting Summarizer Command Prompt": {
            "path": "${env:COMSPEC}",
            "args": [
                "/k",
                "call .venv\\Scripts\\activate.bat && prompt (venv) $P$G"
            ],
            "icon": "terminal-cmd"
        }
    },
    "terminal.integrated.defaultProfile.windows": "Meeting Summarizer Command Prompt"
}
